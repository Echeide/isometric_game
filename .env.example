# Optional. Keep the real key in .env, never in browser code or project ZIPs.
OPENAI_API_KEY=
# Supported: gpt-image-2.5-sunburst, gpt-image-2.5-flare, gpt-image-2
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Optional Kling 2.6 video generation through Magnific. Server only.
MAGNIFIC_API_KEY=
MAGNIFIC_API_KEY_NAME=pixelart
# Stored for future callbacks; local development polls and does not use webhooks.
MAGNIFIC_WEBHOOK_SECRET=

# Railway production only. API keys remain private server variables.
ORIGIN=
CHARACTER_WORKSHOP_USER=
# At least 24 characters; protects /characters and /api/characters over HTTPS.
CHARACTER_WORKSHOP_PASSWORD=
# Mount a Railway volume here to preserve video tasks and downloads across deploys.
CHARACTER_VIDEO_JOBS_DIR=/data/character-video-jobs
# Base64 PNG requests can reach 2.8 MB; adapter-node defaults to 512 KB.
BODY_SIZE_LIMIT=3000000
