{
  "name": "isometrico-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/world",
    "packages/character-generator",
    "packages/editor-ui"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run i18n:compile && vitest run",
    "package:world": "npm run package --workspace @isometrico/world",
    "package:characters": "npm run package --workspace @isometrico/character-generator",
    "start": "node build",
    "platform:db": "node scripts/platform-dev-db.mjs",
    "platform:bootstrap": "node --env-file=.env scripts/platform-bootstrap.mjs",
    "test:platform": "vitest run tests/platform.test.ts",
    "modules:styles": "node scripts/build-routing-module-css.mjs",
    "i18n:compile": "node scripts/compile-i18n.mjs",
    "storage:probe": "node --env-file=.env scripts/storage-probe.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@isometrico/character-generator": "*",
    "@isometrico/editor-ui": "*",
    "@isometrico/world": "*",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "hls.js": "^1.7.3",
    "howler": "^2.2.4",
    "lucide-svelte": "^0.468.0",
    "pg": "^8.23.1",
    "pixi.js": "^8.13.0",
    "quill": "^2.0.3",
    "svelte": "^5.38.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.27.0",
    "@inlang/plugin-message-format": "^4.5.0",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
